[
    {
	 "layer": "bottom",
 	   "position": "top",
 	   "margin-top": 20,
 	   "margin-left": 20,
 	   "margin-right": 20,
 	   "id": "bar-1",
 	   "spacing": 15,
 	   "modules-center": ["sway/workspaces"],
	   "modules-right": ["idle_inhibitor", "pulseaudio", "backlight", "battery", "clock"],
       "modules-left": ["custom/power", "custom/apps", "custom/file", "custom/notification", "sway/scratchpad", "tray",],

	 "sway/window": {
          "format": "{}",
          "tooltip": false
        },
     "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "tooltip": false,
        "warp-on-scroll": false,
        "format": "{icon} {name}",
        "format-icons": {
             "urgent": "",
             "focused": "♥︎",
             "default": "♡"}
        },
     "clock": {
        "format": "󰅐 {:L%I:%M %a %m/%d}",
        "locale": "",
        "justify": "center",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
        "mode"          : "month",
        "mode-mon-col"  : 3,
        "weeks-pos"     : "right",
        "on-scroll"     : 1,
        "on-click-right": "mode",
        "format": {
            "months":     "<span color='#ff00ff'><b>{}</b></span>",
            "days":       "<span color='#ff55ff'><b>{}</b></span>",
            "weeks":      "<span color='#aa007f'><b>W{}</b></span>",
            "weekdays":   "<span color='#ff00ff'><b>{}</b></span>",
            "today":      "<span color='#aa007f'><b><u>{}</u></b></span>"}
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": " ",
            "deactivated": " "
            },
        "min-length": 4
    },
    "pulseaudio": {
        "max-volume": 150,
        "format": "{icon} {volume}%",
        "format-icons": [
           "",
           "",
           ""],
        "nospacing": 1,
        "format-muted": " ",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": false,
	    "scroll-step": 3
     },
     "battery": {
	 "bat": "BAT0",
        "states": {
            "warning": 30},
        "interval": 10,
        "tooltip": false,
        "format-time": "{H}:{M:02}",
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}% ({time})",
        "format-plugged": "󰂄 {capacity}% (Plugged)",
        "format-full": "󱈑 {capacity}%",
        "format-icons": [
            "󱊡",
            "󱊢",
            "󱊣"]
     },
     "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": false,
	    "scroll-step": 3,
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "format-icons": "✦",
        "tooltip": true,
        "tooltip-format": "{app}: {title}",
    },
    "tray": {
        "expand": true,
        "show-passive-items": true,
        "icon-size": 20,
        "spacing": 25,
    },
    "custom/power": {
        "format": " ⏻",
        "min-length": 1,
        "tooltip": false,
        "justify": "center",
        "menu": "on-click",
        "menu-file": "/$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "Shutdown": "shutdown",
            "Reboot": "reboot",
            "Log Out": "swaymsg exit",
            "Suspend": "systemctl suspend",
        },
    },
    "custom/file": {
        "format": "⎙",
        "min-length": 1,
        "tooltip": false,
        "justify": "center",
        "menu-file": "/$HOME/.config/waybar/file_menu.xml",
        "menu": "on-click",
        "menu-actions": {
            "Simons Library": "nemo /$HOME/Desktop/simons-library",
            "Downloads": "nemo /$HOME/Downloads",
            "Home": "nemo /$HOME",
            "Root": "nemo /",
            "Config": "nemo /$HOME/.config",
            "Local": "nemo /$HOME/.local",
            "Waybar": "nemo /$HOME/.config/waybar",
            "Sway": "nemo /$HOME/.config/sway",
        },
    },
    "custom/apps": {
        "tooltip": false,
        "justify": "center",
        "format": "☰",
        "menu-file": "$HOME/.config/waybar/app_menu.xml",
        "menu": "on-click",
        "menu-actions": {
            "Steam": "steam",
            "Audacious": "audacious",
            "Tor": "tor browser",
            "Kate": "kate",
            "Nicotine": "nicotine",
            "Zotero": "zotero",
        },
    },
    "custom/notification": {
        "tooltip": false,
        "min-length": 1,
        "justify": "center",
        "format": "{icon}",
        "format-icons": {
            "notification": "˗ˋˏ♥︎<span foreground='red'><sup></sup></span>ˎˊ˗",
            "none": "‎♡",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true},
},
// ------------------------------------------------------------------------------ //
    {
    "layer": "top",
    "position": "bottom",
    "margin-left": 20,
    "margin-right": 20,
    "margin-bottom": 20,
    "spacing": 15,
    "id": "bar-0",
    "exclusive": true,
    "ipc": true,
    "modules-left": ["mpris"],
    "modules-right": ["sway/language", "memory", "cpu", "network", "bluetooth"],

    "cpu": {
        "format": "CPU {usage}%",
	    "format-alt": "{load}% Load",
        "tooltip": false,
        "interval": 30,
        "on-click-right": "kitty -e btop",
    },
    "memory": {
        "format": "Memory {}%",
        "interval": 30,
        "justify": "center",
        "tooltip": false
    },
    "network": {
        "format-wifi": "  {}",
    	"format-alt": "  ⇣{bandwidthDownBytes} ⇡{bandwidthUpBytes}",
        "format-disconnected": "󰤮 No Network",
        "tooltip": false,
        "interval": 5
    },
    "bluetooth":{
        "format": "ᚼᛒ {status}",
        "format-connected": "ᚼᛒ {device_alias} {icon} {device_battery_percentage}%",
	    "format-icons": [
	        "󱊡",
            "󱊢",
            "󱊣"],
	    "format-disabled": "",
	    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
	    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	    "on-click-right": "Bluetooth_Manager -e",
    },
    "mpris": {
 	    "format": "{status_icon} {artist} {status_icon} {album} - <i>{title}</i> {status_icon}",
 	    "max-length": 50,
        "artist-len": 20,
        "album-len": 20,
        "title-len": 100,
        "elipses": "...",
        "justify": "center",
        "interval": 1,
	    "status-icons": {
		    "playing": "♥︎",
		    "paused": "♡"},
        "ignored-players": ["firefox"]
    },
    "sway/language": {
		"format": "  {}",
		"min-length": 5,
		"on-click": "swaymsg 'input * xkb_switch_layout next'",
    	"tooltip": false,
	},
   },
]
