[
    {
	 "layer": "bottom",
 	   "position": "top",
 	   "margin-top": 10,
 	   "margin-left": 20,
 	   "margin-right": 20,
 	   "id": "bar-1",
	   "modules-right": ["idle_inhibitor", "custom/arrow2", "pulseaudio", "custom/arrow2", "battery", "custom/arrow2", "clock"],
       "modules-left": ["custom/power", "custom/file", "custom/notification", "tray", "sway/scratchpad", "custom/arrow", "sway/workspaces"],

    "battery": {
	 "bat": "BAT0",
        "states": {
            "warning": 30},
        "interval": 10,
        "tooltip": false,
        "format-time": "{H}:{M:02}",
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}% ({time})",
        "format-plugged": "󰂄 {capacity}% (Plugged)",
        "format-full": "󱈑 {capacity}%",
        "format-icons": [
            "󱊡",
            "󱊢",
            "󱊣"]
     },
     "clock": {
        "format": "󰅐 {:L%I:%M %a %m/%d}",
        "on-click": "rencal",
        "locale": "",
        "justify": "center",
        "tooltip": false,
    },
    "custom/arrow": {
        "format": "⟫",
        "tooltip": false,
    },
    "custom/arrow2": {
        "format": "⟪",
        "tooltip": false,
    },
    "custom/file": {
        "format": "☰",
        "min-length": 1,
        "tooltip": false,
        "justify": "center",
        "menu-file": "/$HOME/.config/waybar/file_menu.xml",
        "menu": "on-click",
        "menu-actions": {
            "Simons Library": "nemo /$HOME/Desktop/simons-library",
            "Downloads": "nemo /$HOME/Downloads",
            "Screenshots": "nemo /$HOME/Pictures/Screenshots",
            "Home": "nemo /$HOME",
            "Root": "nemo /",
            "Config": "nemo /$HOME/.config",
            "Local": "nemo /$HOME/.local",
            "Waybar": "nemo /$HOME/.config/waybar",
            "Sway": "nemo /$HOME/.config/sway",
            "Waybar Config": "kate /$HOME/.config/waybar/config",
            "Sway Config": "kate /$HOME/.config/sway/config",
            "Update": "kate /$HOME/.local/logs/updates.txt"
        },
    },
    "custom/power": {
        "format": "⏻",
        "min-length": 1,
        "tooltip": false,
        "justify": "center",
        "menu": "on-click",
        "menu-file": "/$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "Shutdown": "shutdown",
            "Reboot": "reboot",
            "Log Out": "swaymsg exit",
            "Suspend": "systemctl suspend",
            "Update": "kitty sudo /$HOME/.config/waybar/updates.sh"
        },
    },
    "custom/notification": {
        "tooltip": false,
        "min-length": 1,
        "justify": "center",
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'>♥︎</span>",
            "none": "‎♡",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
        },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": " ",
            "deactivated": " "
            },
        "min-length": 2
    },
    "pulseaudio": {
        "max-volume": 150,
        "format": "{icon} {volume}%",
        "format-icons": [
           "",
           "",
           ""],
        "nospacing": 1,
        "format-muted": "⦸",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": false,
	    "scroll-step": 3
     },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "format-icons": "✦",
        "tooltip": true,
        "tooltip-format": "{app}: {title}",
    },
     "sway/window": {
          "format": "{}",
          "tooltip": false
        },
     "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "tooltip": false,
        "warp-on-scroll": false,
        "format": "{icon} {name}",
        "format-icons": {
             "urgent": "<span foreground='red'></span>",
             "focused": "♥︎",
             "default": "‎♡"}
        },
    "tray": {
        "expand": true,
        "show-passive-items": true,
        "icon-size": 23,
        "spacing": 15,
    },
},
// ------------------------------------------------------------------------------ //
    {
    "layer": "overlay",
    "position": "bottom",
    "margin-left": 20,
    "margin-right": 20,
    "margin-bottom": 10,
    "id": "bar-0",
    "mode": "hide",
    "ipc": true,
    "exclusive": false,
    "modules-left": ["mpris"],
    "modules-right": ["sway/language", "custom/arrow3", "backlight", "custom/arrow3", "temperature", "custom/arrow3", "memory", "custom/arrow3", "cpu", "custom/arrow3", "network", "custom/arrow3", "bluetooth"],

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": false,
        "scroll-step": 3,
    },
    "bluetooth":{
        "format": "ᚼᛒ {status}",
        "format-connected": "ᚼᛒ {device_alias} {icon} {device_battery_percentage}%",
	    "format-icons": [
	        "󱊡",
            "󱊢",
            "󱊣"],
	    "format-disabled": "",
	    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
	    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	    "on-click": "kitty -e bluetui",
    },
    "cpu": {
        "format": "CPU {usage}%",
	    "format-alt": "{load}% Load",
        "tooltip": false,
        "interval": 30,
        "on-click-right": "kitty -e btop",
    },
    "custom/arrow3": {
        "format": "⟪",
        "tooltip": false,
    },
    "memory": {
        "format": "Memory {}%",
        "interval": 30,
        "justify": "center",
        "tooltip": false
    },
    "mpris": {
 	    "format": "{status_icon} {artist} {status_icon} {album} - <i>{title}</i> {status_icon}",
 	    "max-length": 50,
        "artist-len": 20,
        "album-len": 20,
        "title-len": 100,
        "elipses": "...",
        "justify": "center",
        "interval": 1,
	    "status-icons": {
		    "playing": "♥︎",
		    "paused": "♡"},
        "ignored-players": ["firefox"]
    },
    "network": {
        "format-wifi": "  {}",
        "format-disconnected": "󰤮 No Network",
        "format-disabled": "󰤮 Wifi Disabled",
        "tooltip-format": "  ⇣{bandwidthDownBytes} ⇡{bandwidthUpBytes}\n\nSignal Strength ({signalStrength}%)",
        "interval": 5,
        "menu": "on-click",
        "menu-file": "/$HOME/.config/waybar/network.xml",
        "menu-actions": {
            "Connection Interface": "nm-connection-editor",
            "Wifi On": "nmcli radio wifi on",
            "Wifi Off": "nmcli radio wifi off",
            "NM-Applet": "nm-applet",
        },
    },
    "sway/language": {
		"format": "  {}",
		"min-length": 5,
		"on-click": "swaymsg 'input * xkb_switch_layout next'",
    	"tooltip": false,
	},
    "temperature": {
        "thermal-zone": 2,
        "format": "{temperatureF}°F {icon}",
        "format-icons": ["󰉬", "", "󰉪"],
        "tooltip": false,
    },
   },
]
