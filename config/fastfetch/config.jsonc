{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
	    "source": "~/.config/fastfetch/heart.txt",
	    "color": {
            "1": "38;2;179;18;109"
	    },
		"padding": {
			"top": 2,
		},
    },
  "display": {
    "separator": "| ",
    },
  "modules": [
        "break",
        "break",
        "break",

        {
            "type": "title",
            "keyWidth": 10,
			"format": "═══════════ஓ๑ {}@{} ๑ஓ═══════════",
        },

        {
            "type": "os",
            "key": "OS   ",
            "keyColor": "38;2;172;0;172",
			"format": "{} {}",
        },
        {
            "type": "kernel",
            "key": "KERN ",
            "keyColor": "38;2;172;0;172",
			"format": "{} {}",
        },
        {
            "type": "packages",
            "key": "PKGC ",
            "keyColor": "38;2;172;0;172",
			"format": "",
        },

        {
            "type": "custom",
            "format": "══════════════════════════════════════════",
        },


        {
            "type": "shell",
            "key": "SH   ",
            "keyColor": "38;2;172;0;172",
			"format": "{}",
        },
        {
            "type": "terminal",
            "key": "TERM ",
            "keyColor": "38;2;172;0;172",
			"format": "{}",
        },
        {
            "type": "wm",
            "key": "WM   ",
            "keyColor": "38;2;172;0;172",
			"format": "{}",
        },
        {
            "type": "uptime",
            "key": "UPT  ",
            "keyColor": "38;2;172;0;172",
			"format": "{2}h {3}m",
        },

		{
			"type": "cpu",
            "key": "CPU  ",
            "keyColor": "38;2;172;0;172",
			"format": "{}",
		},
		{
			"type": "gpu",
            "key": "GPU  ",
            "keyColor": "38;2;172;0;172",
			"format": "{} {}",
		},
		{
			"type": "memory",
            "key": "MEM  ",
            "keyColor": "38;2;172;0;172",
			"format": "",
		},
		{
			"type": "display",
            "key": "MNTR ",
            "keyColor": "38;2;172;0;172",
			"format": "{}x{} {}Hz {6} {7}",
		},

        {
            "type": "custom",
            "format": "════════════════ ᓚ₍^..^₎♡ ════════════════",
        },

        "break",
        "break",
        "break",
    ]
}
